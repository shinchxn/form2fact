# =========================================================================
# FORM2FACT — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# This template defines required and recommended environment variables for
# a production deployment of Form2Fact.
#
# IMPORTANT SECURITY DIRECTIVES:
# 1. NEVER commit production .env files or credentials to Git.
# 2. Set file permissions: chmod 600 .env
# 3. All passwords and secrets below are place-holders and MUST be replaced.
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# -------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# -------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (STRICT P0 POLICIES)
# -------------------------------------------------------------------------
# MANDATORY: Minimum 32 characters, high-entropy cryptographic secret.
# In production, the server will crash on startup if JWT_SECRET is unset,
# under 32 characters, or matches default development fallback strings.
# Generate via: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_32_CHAR_SECRET

# JWT token lifespan. Recommended: 8h to 24h for institutional regulatory sessions
TOKEN_EXPIRY=12h

# -------------------------------------------------------------------------
# 3. SECURE ONE-TIME INITIAL ADMINISTRATOR PROVISIONING (BLOCKER 1)
# -------------------------------------------------------------------------
# In production, default demo user seeding is strictly disabled.
# To bootstrap the initial institutional administrator account on first boot,
# specify the bootstrap email and a strong password (minimum 12 characters,
# non-trivial). Once initialized, subsequent bootstrap attempts are rejected.
#
# Alternatively, use POST /api/v1/auth/bootstrap-admin once on clean deployment.
BOOTSTRAP_ADMIN_EMAIL=admin@institution.edu.in
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_MINIMUM_12_CHAR_STRONG_BOOTSTRAP_PASSWORD

# Disable all demonstration application, finding, and document seeding
SEED_DEMO_DATA=false

# -------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE (SINGLE-NODE RUNTIME ARCHITECTURE)
# -------------------------------------------------------------------------
# Form2Fact v1.2.0 operates on a high-integrity, single-node SQLite engine
# via node:sqlite DatabaseSync with WAL (Write-Ahead Logging) journal mode.
# Multi-node distributed databases (PostgreSQL) require future driver abstraction.
DATABASE_PATH=./data/form2fact.db

# -------------------------------------------------------------------------
# 5. DOCUMENT STORAGE & PROVENANCE
# -------------------------------------------------------------------------
# Uploaded applicant PDF dockets are stored in an append-only, tamper-evident
# filesystem directory with cryptographic SHA-256 integrity checksums.
DOCUMENT_STORAGE_PATH=./data/dockets

# -------------------------------------------------------------------------
# 6. AI DOCUMENT INTELLIGENCE & STRICT INFERENCE (BLOCKER 3)
# -------------------------------------------------------------------------
# Internal FastAPI microservice endpoint running the calibrated V2 hybrid
# pairwise classifier (MiniLM-L6-v2 + HistGradientBoostingClassifier).
AI_SERVICE_URL=http://127.0.0.1:8000

# STRICT PRODUCTION ENFORCEMENT:
# In production mode:
# - REQUIRE_ML_INFERENCE MUST be true
# - ALLOW_DETERMINISTIC_FALLBACK MUST be false
# If the AI service is unavailable, unclassifiable ambiguous pairs will
# strictly abstain to 'UNCERTAIN' for mandatory human adjudication rather
# than executing uncalibrated silent lexical fallbacks.
REQUIRE_ML_INFERENCE=true
ALLOW_DETERMINISTIC_FALLBACK=false

# Pre-shared authentication token for internal AI service endpoints
OCR_SERVICE_TOKEN=REPLACE_WITH_STRONG_INTERNAL_OCR_SERVICE_TOKEN

# Active ML champion model identifier
MODEL_VERSION=form2fact-hybrid-pairwise-v2.0-champion
MODEL_PATH=./ai_service/models

# -------------------------------------------------------------------------
# 7. OBSERVABILITY & AUDIT
# -------------------------------------------------------------------------
LOG_LEVEL=INFO

