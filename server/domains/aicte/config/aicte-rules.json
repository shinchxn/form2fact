  "rules": [
    {
      "ruleId": "AICTE-APH-PL-001",
      "title": "Private land lease validity",
      "requirement": "The registered private land lease must have at least 30 years of validity as of the date of the Council notification.",
      "appliesTo": [
        "PRIVATE_LAND"
      ],
      "check": "MINIMUM_TENURE_FROM_NOTIFICATION",
      "version": "1.0.0",
      "status": "UNDER_REVIEW",
      "sourceVerification": "VERIFIED",
      "reviewApproval": "PENDING",
      "sourcePage": 78,
      "effectivePeriod": {
