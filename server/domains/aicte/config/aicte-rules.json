        "effectiveTo": null
      },
      "exceptions": []
    },
    {
      "ruleId": "AICTE-APH-PL-002",
      "title": "Registered private land lease deed",
      "requirement": "A private land lease deed registered with the competent authority under the Registration Act must be produced.",
      "appliesTo": [
        "PRIVATE_LAND"
      ],
      "check": "REQUIRED_DOCUMENT",
      "requiredDocumentType": "Land Lease Deed",
