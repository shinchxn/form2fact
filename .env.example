# =========================================================================
# FORM2FACT — ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to .env for local development or set container variables.
# NEVER commit the actual .env file or real production credentials.
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME ENVIRONMENT
# -------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV=development

# Port on which the Express API server listens
PORT=3000

# -------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (P0 SECURITY MANDATE)
# -------------------------------------------------------------------------
# In production (NODE_ENV=production), JWT_SECRET is MANDATORY.
# It MUST be at least 32 characters long and MUST NOT use default dev values.
# Generate a secure secret with: openssl rand -base64 32
JWT_SECRET=development_only_secret_key_minimum_32_characters_for_local_testing

# JWT Token validity duration (e.g., 24h, 7d)
TOKEN_EXPIRY=24h

# -------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE
# -------------------------------------------------------------------------
# Relative or absolute path to SQLite database file
DATABASE_PATH=./data/form2fact.db

# -------------------------------------------------------------------------
# 4. DOCUMENT STORAGE & DOCKETS
# -------------------------------------------------------------------------
# Filesystem path where uploaded applicant documents (PDFs) are stored
DOCUMENT_STORAGE_PATH=./data/dockets

# -------------------------------------------------------------------------
# 5. AI DOCUMENT INTELLIGENCE & OCR MICROSERVICE
# -------------------------------------------------------------------------
# URL of internal FastAPI pairwise classification and OCR service
# Local dev: http://localhost:8000
# Docker Compose: http://ai-service:8000
AI_SERVICE_URL=http://localhost:8000

# Authentication secret for internal AI OCR endpoints (X-OCR-Service-Token)
OCR_SERVICE_TOKEN=form2fact_ocr_secret_token_2026

# Active ML model version to load from models/ manifest
MODEL_VERSION=form2fact-hybrid-pairwise-v2.0-champion

# Path to versioned model artifact registry
MODEL_PATH=./ai_service/models

# -------------------------------------------------------------------------
# 6. LOGGING & OBSERVABILITY
# -------------------------------------------------------------------------
# Logging verbosity: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# -------------------------------------------------------------------------
# 7. OPTIONAL ENTERPRISE SERVICES (docker compose --profile enterprise up)
# -------------------------------------------------------------------------
POSTGRES_USER=form2fact_admin
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=form2fact_db
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=form2fact_minio_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_secret_2026
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=form2fact-dockets

# -------------------------------------------------------------------------
# 8. BHARATCODE MODEL API INTEGRATION (BHARATCODE BUILD LEAGUE 2026)
# -------------------------------------------------------------------------
# Official BharatCode Model API Base URL
BHARATCODE_API_URL=https://bharatcode.ai/api/model/v1

# BharatCode API Key (Bearer token, e.g. bc_live_...)
# Required for generating evidence-grounded AI explanations with Qwen 3.8 27B.
# If omitted or unconfigured, Form2Fact gracefully falls back to deterministic findings.
BHARATCODE_API_KEY=your_bharatcode_api_key_here

# BharatCode Model ID (default: qwen-3.8-27b)
BHARATCODE_MODEL=qwen-3.8-27b

# Outbound request timeout in milliseconds.
# qwen-3.8-27b is a reasoning model that consumes part of its token budget on
# internal chain-of-thought before the final answer, so the default was raised
# from 5s to 60s. Raise further (e.g. 90000) on slow networks.
BHARATCODE_TIMEOUT_MS=60000

