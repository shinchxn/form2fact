node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
!.env.production.example

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/

# AI Studio session cache
.aistudio/
.opencode/

# Runtime storage & databases (preserve directory structure and README)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/dockets/*
!data/dockets/.gitkeep
!data/README.md

# Large ML dataset caches and raw downloads
ai_service/ml/data/v2_acquisition/raw/
ai_service/ml/data/v2_acquisition/extracted/
*.tar.gz
*.zip
*.bin

# V3 Machine Learning Data Isolation & Confidentiality Guards
ai_service/ml/data/v3/raw/**
!ai_service/ml/data/v3/raw/**/
!ai_service/ml/data/v3/raw/**/.gitkeep
!ai_service/ml/data/v3/raw/**/README.md

# Prevent accidental commitment of confidential institutional documents in V3 pipelines
ai_service/ml/data/v3/**/*.pdf
ai_service/ml/data/v3/**/*.tif
ai_service/ml/data/v3/**/*.tiff
ai_service/ml/data/v3/**/*.png
ai_service/ml/data/v3/**/*.jpg
ai_service/ml/data/v3/**/*.jpeg
!ai_service/ml/data/v3/**/.gitkeep

# Exclude local V3 uncommitted training checkpoints
ai_service/ml/artifacts/v3/checkpoints/
ai_service/ml/artifacts/v3/*.tmp

# Playwright test artifacts
test-results/
playwright-report/
